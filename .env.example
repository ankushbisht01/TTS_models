# ─────────────────────────────────────────────────────────────────────
# Voice Cloning Server — Environment Configuration
#
# Copy this file to .env and edit as needed:
#   cp .env.example .env
#
# All settings can also be set as environment variables.
# ─────────────────────────────────────────────────────────────────────

# ── Backend Configuration ─────────────────────────────────────────────
# Which TTS backends to load at startup (comma-separated)
# Options: f5tts, chatterbox, qwen3tts
ACTIVE_BACKENDS=f5tts

# Default backend when none specified in request
DEFAULT_BACKEND=f5tts

# ── Server ────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
WORKERS=1

# ── GPU ───────────────────────────────────────────────────────────────
DEVICE=cuda
DTYPE=float16

# ── Audio ─────────────────────────────────────────────────────────────
SAMPLE_RATE=24000
MAX_REF_DURATION_SEC=30.0
MAX_GEN_CHARS=5000

# ── F5-TTS ────────────────────────────────────────────────────────────
F5TTS_MODEL_TYPE=F5-TTS
# Leave empty for auto-download from HuggingFace
F5TTS_CKPT_FILE=
F5TTS_VOCAB_FILE=

# ── Chatterbox ────────────────────────────────────────────────────────
CHATTERBOX_MODEL=chatterbox
CHATTERBOX_EXAGGERATION=0.5

# ── Qwen3-TTS ─────────────────────────────────────────────────────────
# Suffix picks the mode: -Base (clones from reference audio),
# -CustomVoice (preset speakers), -VoiceDesign (voice from a description)
QWEN3TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-Base
QWEN3TTS_LANGUAGE=English
QWEN3TTS_SPEAKER=Ryan
QWEN3TTS_INSTRUCT=

# ── Fine-Tuning / Transcription ───────────────────────────────────────
# Used only by scripts/prepare_dataset.py --transcribe.
# With this set, transcription runs on Groq's API instead of a local
# Whisper — faster, no GPU needed, but each audio segment is uploaded.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
